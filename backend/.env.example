DB_HOST=127.0.0.1
DB_PORT=9912
DB_NAME=signalradar
DB_USER=signalradar
DB_PASSWORD=replace_with_your_local_password
YOUTUBE_API_KEY=
# Local development/test fixtures only; false preserves YouTube collection.
USE_MOCK_SOURCE=false
OLLAMA_BASE_URL=http://localhost:11434
# Exact installed name from ollama list; required for analysis.
OLLAMA_MODEL=
# 本机完整请求/响应调试日志；可能包含私人内容，默认关闭。
OLLAMA_TRACE_ENABLED=false
SCHEDULER_ENABLED=false
SCAN_INTERVAL_MINUTES=60
NOTIFICATIONS_ENABLED=false

# 可选模型兼容提示，非通用 thinking 开关；不保证模型停止思考
OLLAMA_NO_THINK_HINT=false
